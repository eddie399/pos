generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  name                String
  phone               String?          @unique
  email               String?          @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  accounts            Account[]
  sessions            Session[]
  memberships         ShopMember[]
  auditLogs           AuditLog[]
  sales               Sale[]
  expenses            Expense[]        @relation("ExpenseCreatedBy")
  stockMovements      StockMovement[]  @relation("StockMovementCreatedBy")
  dailySessionsOpened DailySession[]   @relation("DailySessionOpenedBy")
  dailySessionsClosed DailySession[]   @relation("DailySessionClosedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Shop {
  id          String       @id @default(cuid())
  name        String
  phone       String?
  address     String?
  currency    String       @default("MWK")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     ShopMember[]
  categories  Category[]
  products    Product[]
  customers   Customer[]
  sales       Sale[]
  expenses    Expense[]
  stockMovements StockMovement[]
  auditLogs   AuditLog[]
  dailySessions DailySession[]

  @@map("shops")
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      String   @default("CASHIER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, userId])
  @@map("shop_members")
}

model Category {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([shopId, name])
  @@map("categories")
}

model Product {
  id                String          @id @default(cuid())
  shopId            String
  categoryId        String?
  name              String
  barcode           String?
  costPrice         Decimal         @db.Decimal(12, 2)
  sellingPrice      Decimal         @db.Decimal(12, 2)
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(0)
  unit              String          @default("PIECE")
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category          Category?       @relation(fields: [categoryId], references: [id])
  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  @@unique([shopId, barcode])
  @@index([shopId, barcode])
  @@map("products")
}

model Customer {
  id          String              @id @default(cuid())
  shopId      String
  name        String
  phone       String?
  creditLimit Decimal             @db.Decimal(12, 2)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales       Sale[]
  transactions CustomerTransaction[]

  @@map("customers")
}

model Sale {
  id            String     @id @default(cuid())
  shopId        String
  cashierId     String
  customerId    String?
  /**
   * Idempotency key minted by the selling device. An offline sale can be
   * retried any number of times without ever being recorded twice.
   */
  clientRef     String?    @unique
  receiptNumber String     @unique
  subtotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal    @db.Decimal(12, 2) @default(0)
  total         Decimal    @db.Decimal(12, 2)
  paymentStatus String     @default("PENDING")
  createdAt     DateTime   @default(now())
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashier       User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  payments      Payment[]
  transactions  CustomerTransaction[]

  @@index([shopId, createdAt])
  @@map("sales")
}

model SaleItem {
  id                 String   @id @default(cuid())
  saleId             String
  productId          String
  productNameSnapshot String
  quantity           Int
  unitCostSnapshot   Decimal  @db.Decimal(12, 2)
  unitPriceSnapshot  Decimal  @db.Decimal(12, 2)
  discount           Decimal  @db.Decimal(12, 2) @default(0)
  total              Decimal  @db.Decimal(12, 2)
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String
  method    String
  amount    Decimal  @db.Decimal(12, 2)
  provider  String?
  reference String?
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model CustomerTransaction {
  id          String   @id @default(cuid())
  shopId      String
  customerId  String
  saleId      String?
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal @db.Decimal(12, 2)
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale        Sale?    @relation(fields: [saleId], references: [id])

  @@index([shopId, customerId])
  @@map("customer_transactions")
}

model StockMovement {
  id              String   @id @default(cuid())
  shopId          String
  productId       String
  type            String
  quantity        Int
  previousQuantity Int
  newQuantity     Int
  referenceType   String?
  referenceId     String?
  reason          String?
  createdBy       String?
  createdAt       DateTime @default(now())
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator         User?    @relation("StockMovementCreatedBy", fields: [createdBy], references: [id])

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Expense {
  id          String   @id @default(cuid())
  shopId      String
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdBy   String
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator     User     @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@map("expenses")
}

model DailySession {
  id            String    @id @default(cuid())
  shopId        String
  openingCash   Decimal   @db.Decimal(12, 2)
  closingCash   Decimal?  @db.Decimal(12, 2)
  expectedCash  Decimal?  @db.Decimal(12, 2)
  cashDifference Decimal? @db.Decimal(12, 2)
  openedBy      String
  closedBy      String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  opener        User      @relation("DailySessionOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  closer        User?     @relation("DailySessionClosedBy", fields: [closedBy], references: [id])

  @@index([shopId, closedAt])
  @@map("daily_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
